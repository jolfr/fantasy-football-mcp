# Copy to .env and fill in. Get cookies from your browser's dev tools
# (Application > Cookies > espn.com) while logged in to ESPN.
ESPN_S2=
ESPN_SWID={XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}
ESPN_LEAGUE_ID=
